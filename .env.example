# Copy to .env.local

# --- VegPro FDB: MS SQL (in migration — set when app phases 2–4 are deployed) ---
# DATA_BACKEND=mssql
# NEXT_PUBLIC_DATA_BACKEND=mssql
# MSSQL_SERVER=192.168.16.14
# MSSQL_DATABASE=Scouting
# MSSQL_USER=
# MSSQL_PASSWORD=
# MSSQL_PORT=1433
# MSSQL_ENCRYPT=true
# MSSQL_TRUST_SERVER_CERTIFICATE=true
# SESSION_SECRET=change-me-to-a-long-random-string
# EVIDENCE_STORAGE_PATH=D:\Apps\vegpro-scouting\data\evidence

# --- Supabase (current dev / cloud path until MSSQL app layer is complete) ---
# keys from Dashboard → Project Settings → API Keys

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# New projects: publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy projects: anon JWT — either publishable or anon works
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Required for Admin → create worker/manager accounts.
# Dashboard → Project Settings → API → service_role (or secret key).
# Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: surveyed Star farm centroid (WGS84). Defaults to Naivasha corridor.
# Per-house surveyed GPS in greenhouses.lat/lng always wins over this base.
# NEXT_PUBLIC_STAR_FARM_BASE_LAT=-0.7172
# NEXT_PUBLIC_STAR_FARM_BASE_LNG=36.431

# Optional aliases used in some environments
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_STORAGE_BUCKET=activity-evidence
# NEXT_PUBLIC_DISABLE_PWA=true
# SUPABASE_SECRET_KEY=
